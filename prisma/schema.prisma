generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id     Int    @id @default(autoincrement())
  name   String
  userId Int?
  guid   String?

  @@index([userId])
  @@index([guid])
}

model Group {
  id     Int    @id @default(autoincrement())
  userId Int?
  guid   String?
  name   String

  @@index([userId])
  @@index([guid])
}

model Task {
  id            Int     @id @default(autoincrement())
  userId        Int?
  guid          String?
  groupName     String
  groupId       Int?
  activityName  String
  activityId    Int?
  member        String
  dueDate       String
  name          String?
  location      String?
  type          String
  completeddate String?
  link          String?
  status        String  @default("created")
  taskId        String?
  updatedBy     String?
  url           String?

  @@index([userId])
  @@index([guid])
  @@index([taskId])
  @@unique([taskId, userId])
  @@unique([taskId, guid])
}

model User {
  id                          Int                       @id @default(autoincrement())
  email                       String                    @unique
  name                        String?
  cancellationReason          String?
  lastPaymentDate             DateTime?
  link                        String?
  otp                         String?
  otpExpiration               DateTime?
  password                    String?
  subscriptionType            SubscriptionType
  userType                    UserType
  createdAt                   DateTime                  @default(now())
  isDisabled                  Boolean                   @default(false)
  passwordResetToken          String?
  passwordResetTokenExpiresAt DateTime?
  deviceToken                 String?
  deviceTokens                DeviceToken[]
  locationResponsesAsAdmin    LocationRequestResponse[] @relation("LocationResponseAdmin")
  locationResponsesAsUser     LocationRequestResponse[] @relation("LocationResponseUser")
  subscriptions               Subscription[]
}

model Subscription {
  id                 Int       @id @default(autoincrement())
  userId             Int
  razorpayCustomerId String
  planId             String
  startDate          DateTime  @default(now())
  endDate            DateTime?
  amount             Int
  status             String
  autoRenew          Boolean   @default(true)
  renewalCount       Int       @default(0)
  payments           Payment[]
  user               User      @relation(fields: [userId], references: [id])
}

model Payment {
  id                Int          @id @default(autoincrement())
  subscriptionId    Int
  amount            Int
  paymentDate       DateTime     @default(now())
  status            String
  razorpayPaymentId String?
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
}

model Link {
  id            Int     @id @default(autoincrement())
  link          String  @unique
  owner         String?
  completeddate String?
  duedate       String?
  freecount     Int     @default(5)
  group         String?
  isAccessed    Int     @default(0)
  location      String?
  member        String?
  subscription  String?
  taskId        String
  taskname      String?
  updatedBy     String?
  status        String  @default("created")
  userId        Int?
  guid          String?

  @@index([userId])
  @@index([guid])
}

model paidmemberdata {
  id       Int    @id @default(autoincrement())
  link     String
  otp      String
  otpcount Int    @default(1)
}

model Ad {
  id         Int      @id @default(autoincrement())
  contentUrl String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int?
  token     String   @unique
  platform  String   @default("unknown")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([taskId])
}

model LocationRequestResponse {
  id          Int       @id @default(autoincrement())
  requestId   String
  adminId     Int
  userId      Int
  status      String
  latitude    Float?
  longitude   Float?
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  location    String?
  admin       User      @relation("LocationResponseAdmin", fields: [adminId], references: [id])
  user        User      @relation("LocationResponseUser", fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
  @@index([adminId])
}

model LocationRequestNotification {
  id          Int      @id @default(autoincrement())
  requestId   String   @unique
  taskId      String
  deviceToken String
  status      String   @default("pending")
  sentAt      DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserType {
  Superadmin
  Admin
  User
}

enum SubscriptionType {
  Free
  Professional_monthly
  Professional_yearly
  Premium_monthly
  Premium_yearly
}
